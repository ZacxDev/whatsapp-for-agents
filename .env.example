# whatsapp-for-agents — example environment.
#
#   cp .env.example .env   and fill it in. `.env` is gitignored.
#
# 🔴 Every value here is a placeholder. Generate real ones — in particular never
# reuse the CHANGE-ME strings, and never commit a filled-in .env.

# --------------------------------------------------------------------------- #
# Postgres
#
# ONE server, TWO databases: `whatsapp` (the archive) and `wuzapi` (the linked
# device's session keys). They are separate databases on purpose — see the role
# split in deploy/postgres/init/01-databases.sh.
# --------------------------------------------------------------------------- #

# Superuser, used only to bootstrap roles/databases on first start.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE-ME

# The archive role. Owns database `whatsapp` and must have NO access to `wuzapi`.
WHATSAPP_APP_PASSWORD=CHANGE-ME

# The daemon's role. Owns database `wuzapi`; the archive role cannot reach it.
WUZAPI_DB_PASSWORD=CHANGE-ME

# --------------------------------------------------------------------------- #
# The archive's own configuration.
# --------------------------------------------------------------------------- #

# REQUIRED. Any libpq DSN, URI or key=value form. The bundled compose file wires
# this for you; set it by hand when running against any other Postgres.
WHATSAPP_PG_DSN=postgresql://whatsapp_app:CHANGE-ME@127.0.0.1:5432/whatsapp

# Optional. Rewrite the DSN's ADDRESS without editing the DSN — for a tunnel or a
# port-forward.
# WHATSAPP_PG_HOST=127.0.0.1
# WHATSAPP_PG_PORT=15432

# --------------------------------------------------------------------------- #
# Object storage (OPTIONAL, profile `media` unless you already run an S3
# endpoint). Must speak the S3 API. All three are required for media archiving;
# without them, message ROWS are still stored and media is simply not downloaded.
#
# ⚠ MinIO no longer publishes a pullable community image (verified 2026-11), so
# the bundled profile uses VersityGW. Any S3-compatible server will do.
# --------------------------------------------------------------------------- #
MINIO_ARCHIVE_ENDPOINT=http://127.0.0.1:9000
MINIO_ARCHIVE_ACCESS_KEY=CHANGE-ME
MINIO_ARCHIVE_SECRET_KEY=CHANGE-ME

# --------------------------------------------------------------------------- #
# The linked-device daemon (asternic/wuzapi).
#
# 🔴 Set the two keys BEFORE the first pairing: absent, wuzapi generates them and
# loses them on restart, taking the linked session with it.
# --------------------------------------------------------------------------- #
WUZAPI_ADMIN_TOKEN=CHANGE-ME
WUZAPI_GLOBAL_ENCRYPTION_KEY=CHANGE-ME

# The webhook signing key. 🔴 TWO settings must hold this same value: this global
# one, and wuzapi's PER-USER key, which is set separately via
# `POST /session/hmac/config`. If they diverge NOTHING is stored and it reads as
# "the integration does nothing". At least 32 bytes.
#
# The consumer verifies with the same value, under its own env name.
WHATSAPP_HMAC_KEY=CHANGE-ME-at-least-32-bytes-long

# The wuzapi user the SENDER authenticates as. Needed only to send.
WUZAPI_USER_TOKEN=

# --------------------------------------------------------------------------- #
# Sender
# --------------------------------------------------------------------------- #

# 🔴 OPERATOR-ONLY, AND DELIBERATELY NOT IN THE POD'S ENVIRONMENT. `approve` and
# `unapprove` refuse unless this is present, which is what stops anything able to
# exec in the sender from approving its own draft. Supply it on the command line
# for the one command that needs it; never set it in the Deployment.
# WHATSAPP_APPROVAL_TOKEN=

# --------------------------------------------------------------------------- #
# Optional
# --------------------------------------------------------------------------- #

# Point the DSN-gated live-Postgres suites at a throwaway database. They create
# only fixtures prefixed `1999…` and delete everything with that prefix.
# WHATSAPP_TEST_DSN=

# WHATSAPP_PORT=8080
# WHATSAPP_INSTANCE=whatsapp-consumer
# WHATSAPP_HEARTBEAT_PATH=/var/run/whatsapp/heartbeat.json
# WHATSAPP_HEARTBEAT_INTERVAL=30
# WHATSAPP_HEARTBEAT_MAX_AGE=120
# WHATSAPP_MEDIA_CONCURRENCY=2
